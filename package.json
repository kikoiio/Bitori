{
  "name": "bitori",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first full-screen AI chat client",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "Bitori": "dist/bin/bitori.js"
  },
  "scripts": {
    "dev": "tsx src/bin/bitori.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/bitori.js",
    "bench": "npm run build && tsx benchmarks/run.ts",
    "bench:report": "tsx benchmarks/report.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
