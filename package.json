{
  "name": "bitori",
  "version": "0.1.0",
  "private": true,
  "description": "AI assistant for desktop and terminal",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "bitori": "dist/bin/bitori.js"
  },
  "scripts": {
    "dev": "tsx src/bin/bitori.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/bitori.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "main": "src/desktop/main.cjs",
  "build": {
    "appId": "io.github.kikoiio.bitori",
    "productName": "Bitori",
    "asar": false,
    "directories": {
      "output": "out/desktop"
    },
    "files": [
      "dist/**/*",
      "src/desktop/**/*",
      "package.json"
    ],
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "src/desktop/icon.png"
    }
  },
  "author": "Aries <163719835+kikoiio@users.noreply.github.com>",
  "homepage": "https://github.com/kikoiio/Bitori"
}
